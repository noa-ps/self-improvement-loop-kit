#!/usr/bin/env python3
"""Emit loop-kit harness into a consumer repo. Does not write visualize/ or home memory."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import (  # noqa: E402
    LEARNED_HEADING,
    dump_yaml,
    ensure_learned_section,
    kit_root,
    lint_spec,
    load_spec,
)

HOME_MEMORY_MARKERS = (
    ".claude/projects",
    "memory/MEMORY.md",
    ".codex/memories",
    "AgentStores",
)


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def emit(repo: Path, spec: dict, *, create_probe: bool, playbook_body: str | None = None) -> None:
    kit_dir = repo / "loop-kit"
    if any(m in str(kit_dir) for m in HOME_MEMORY_MARKERS):
        raise SystemExit("refusing to write home-directory memory paths")

    codes = lint_spec(spec, playbook_text="", promote_exists=True)
    # promote.md will exist after emit; ignore NO_WRITEBACK from missing promote during emit
    codes = [c for c in codes if c != "NO_WRITEBACK"]
    if codes:
        raise SystemExit("lint failed before emit: " + ", ".join(codes))

    write(kit_dir / "loop.yaml", dump_yaml(spec))
    sb = kit_dir / "scoreboard.jsonl"
    if not sb.exists():
        write(sb, "")
    write(
        kit_dir / "promote.md",
        (kit_root() / "templates" / "promote.md").read_text(encoding="utf-8"),
    )
    write(
        kit_dir / "CODEX_LOCKS.md",
        (kit_root() / "templates" / "CODEX_LOCKS.md").read_text(encoding="utf-8"),
    )
    write(
        kit_dir / "CURSOR_LOCKS.md",
        (kit_root() / "templates" / "CURSOR_LOCKS.md").read_text(encoding="utf-8"),
    )
    wrapper = (kit_root() / "scripts" / "record-run").read_text(encoding="utf-8")
    write(kit_dir / "record-run", wrapper)
    (kit_dir / "record-run").chmod(0o755)
    write(kit_dir / "kitlib.py", (kit_root() / "scripts" / "kitlib.py").read_text(encoding="utf-8"))

    if create_probe:
        write(
            kit_dir / "probe.sh",
            "#!/bin/sh\n# Independent check. Remediator must not edit this file.\nexit 0\n",
        )
        (kit_dir / "probe.sh").chmod(0o755)

    playbook = repo / spec["playbook_path"]
    if not playbook.exists():
        if not (playbook_body and playbook_body.strip()):
            raise SystemExit(
                "playbook missing — collect the procedure in the interview, then pass --playbook-body"
            )
        write(playbook, playbook_body if playbook_body.endswith("\n") else playbook_body + "\n")
    if playbook.exists():
        original = playbook.read_text(encoding="utf-8")
        updated = ensure_learned_section(original)
        if LEARNED_HEADING in original:
            # still ensure during-run note once
            note = "Do not edit this file or the probe during the remediating session."
            if note not in original:
                updated = original.rstrip() + f"\n\n{note}\n"
        else:
            updated = ensure_learned_section(original)
            if "Do not edit this file or the probe during the remediating session." not in updated:
                updated = updated.rstrip() + "\n\nDo not edit this file or the probe during the remediating session.\n"
        playbook.write_text(updated, encoding="utf-8")

    deny_paths = list(spec.get("deny") or [])
    hook_src = (kit_root() / "scripts" / "deny-write.py").read_text(encoding="utf-8")
    write(kit_dir / "deny-write.py", hook_src)
    quoted = " ".join(json.dumps(p) for p in deny_paths)
    hooks = {
        "hooks": {
            "PreToolUse": [
                {
                    "matcher": "Write|Edit",
                    "hooks": [
                        {
                            "type": "command",
                            "command": f"python3 loop-kit/deny-write.py {quoted}",
                        }
                    ],
                }
            ]
        }
    }
    write(repo / ".claude" / "settings.json", json.dumps(hooks, indent=2) + "\n")

    owners = "\n".join(f"{p} @loop-kit-reviewers" for p in deny_paths)
    write(repo / "CODEOWNERS", owners + "\n")

    viz = kit_dir / "visualize"
    if viz.exists():
        raise SystemExit("emit must not create visualize/")


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--repo", default=".")
    p.add_argument("--spec", help="existing spec to emit from")
    p.add_argument("--create-probe", action="store_true")
    p.add_argument(
        "--playbook-body",
        default="",
        help="markdown collected in the interview when playbook_path does not exist yet",
    )
    args = p.parse_args()
    repo = Path(args.repo).resolve()
    if args.spec:
        spec = load_spec(Path(args.spec))
    else:
        spec = load_spec(repo / "loop-kit" / "loop.yaml")
    create = args.create_probe or not (spec.get("probe") or {}).get("command", "").startswith(".")
    # create probe file only if command points at loop-kit/probe.sh and file missing
    cmd = (spec.get("probe") or {}).get("command") or ""
    create_probe = "loop-kit/probe.sh" in cmd and not (repo / "loop-kit" / "probe.sh").exists()
    if args.create_probe:
        create_probe = True
    body = Path(args.playbook_body).read_text(encoding="utf-8") if args.playbook_body else None
    emit(repo, spec, create_probe=create_probe, playbook_body=body)
    print("emitted loop-kit/ (no visualize/, no memory paths)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
