#!/usr/bin/env python3
"""Apply KEEP / REVERT from scoreboard-summary. REVERT drops the last Learned bullet."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import drop_last_learned, load_jsonl, load_spec, summarize  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--spec", default="loop-kit/loop.yaml")
    p.add_argument("--repo", default=".")
    args = p.parse_args()
    repo = Path(args.repo).resolve()
    spec = load_spec((repo / args.spec).resolve() if not Path(args.spec).is_absolute() else Path(args.spec))
    sb = repo / spec["scoreboard"]["path"]
    yaml_path = repo / args.spec if not Path(args.spec).is_absolute() else Path(args.spec)
    yaml_before = yaml_path.read_bytes()
    sb_before = sb.read_bytes() if sb.exists() else b""
    tally = summarize(load_jsonl(sb) if sb.exists() else [])
    verdict = tally.get("verdict") or "INSUFFICIENT_N"
    print(verdict)
    if verdict == "REVERT":
        playbook = repo / spec["playbook_path"]
        before = playbook.read_text(encoding="utf-8") if playbook.exists() else ""
        playbook.write_text(drop_last_learned(before), encoding="utf-8")
    if yaml_path.read_bytes() != yaml_before:
        raise SystemExit("silk verdict rewrote loop.yaml")
    if (sb.read_bytes() if sb.exists() else b"") != sb_before:
        raise SystemExit("silk verdict rewrote the scoreboard")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
