#!/usr/bin/env python3
"""Print KEEP / REVERT / INSUFFICIENT_N / PROBE_CHANGED from JSONL."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import load_jsonl, summarize  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("scoreboard", nargs="?", default="loop-kit/scoreboard.jsonl")
    args = p.parse_args()
    rows = load_jsonl(Path(args.scoreboard))
    result = summarize(rows)
    print(result["verdict"])
    print(json.dumps({k: v for k, v in result.items() if k != "verdict"}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
